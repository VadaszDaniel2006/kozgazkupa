<Window x:Class="kozgazkupa.jatekosfelvetel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Játékos felvétele" Height="500" Width="800"
        Background="LightGray">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        
        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
               Content="Játékos adatai" FontSize="36" FontWeight="Bold"
               Foreground="DarkGreen" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        
        <Label Grid.Row="1" Grid.Column="1" Content="Játékos neve:" FontSize="20"
               HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBox x:Name="nev" Grid.Row="1" Grid.Column="2" FontSize="20"
                 Width="250" Height="45" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        
        <Label Grid.Row="2" Grid.Column="1" Content="Csapatnév:" FontSize="20"
               HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBox x:Name="csapatnev" Grid.Row="2" Grid.Column="2" FontSize="20"
                 Width="250" Height="45" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        
        <Label Grid.Row="3" Grid.Column="1" Content="Életkor:" FontSize="20"
               HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBox x:Name="eletkor" Grid.Row="3" Grid.Column="2" FontSize="20"
                 Width="250" Height="45" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        
        <Label Grid.Row="4" Grid.Column="1" Content="Mezszám:" FontSize="20"
               HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBox x:Name="mezszam" Grid.Row="4" Grid.Column="2" FontSize="20"
                 Width="250" Height="45" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        
        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"
                    Orientation="Horizontal" HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
            <Button x:Name="button" Content="Ok" FontSize="18" Width="120" Height="50"
                    Background="DarkGreen" Foreground="White" Margin="10,0" Click="button_Click"/>
            <Button x:Name="button1" Content="Mégse" FontSize="18" Width="120" Height="50"
                    Background="DarkOrange" Foreground="White" Margin="10,0" Click="button1_Click"/>
            <Button x:Name="button2" Content="Kilépés" FontSize="18" Width="120" Height="50"
                    Background="DarkRed" Foreground="White" Margin="10,0" Click="button2_Click"/>
        </StackPanel>
    </Grid>
</Window>
