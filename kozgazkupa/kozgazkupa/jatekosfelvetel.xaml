<Window x:Class="kozgazkupa.jatekosfelvetel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kozgazkupa"
        mc:Ignorable="d"
        Title="jatekosfelvetel" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Grid.ColumnSpan="4" Content="Játékos adatai" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <Label Grid.Row="1" Grid.Column="1"  Content="Játékos neve:" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBox x:Name="nev"  Grid.Row="1"  Grid.Column="2"  FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Height="50" Width="200" />

        <Label  Grid.Row="2" Grid.Column="1"  Content="Csapatnév:" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBox x:Name="csapatnev"  Grid.Row="2"  Grid.Column="2"  FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Height="50" Width="200"/>

        <Label  Grid.Row="3" Grid.Column="1"   Content="Életkor:" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBox x:Name="eletkor" Grid.Row="3"  Grid.Column="2"  FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Height="50" Width="200"/>

        <Label  Grid.Row="4"  Grid.Column="1"  Content="Mezszám:" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBox x:Name="mezszam" Grid.Row="4"  Grid.Column="2"  FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Height="50" Width="200"/>

        <Button x:Name="button" Grid.Row="5" Grid.Column="1" Content="Ok" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Left" Height="50" Width="100" Click="button_Click_1"/>
        <Button x:Name="button1" Grid.Row="5"  Grid.ColumnSpan="4" Content="Mégse" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Height="50" Width="100" Click="button1_Click" />
        <Button x:Name="button2" Grid.Row="5" Grid.Column="2" Content="Kilépés" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Right" Height="50" Width="100" Click="button2_Click" />

    </Grid>
</Window>
