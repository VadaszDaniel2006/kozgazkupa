<Window x:Class="kozgazkupa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kozgazkupa"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition />
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.ColumnSpan="3" Content="Foci kupa" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Button x:Name="button1" Grid.Row="2" Grid.ColumnSpan="3"  Content="Csapat felvétel" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Height="50" Width="200" Click="button1_Click"  />
        <Button x:Name="button2" Grid.Row="3" Grid.ColumnSpan="3"  Content="Kilépés" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Height="50" Width="200" Click="button2_Click" />



    </Grid>



</Window>
