<Window x:Class="kozgazkupa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kozgazkupa"
        mc:Ignorable="d"
        Title="Foci Kupa" Height="450" Width="800"
        Background="LightGray">

    <Grid Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition />
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        
        <Label Grid.Row="0" Grid.ColumnSpan="3" Content="Foci Kupa"
               FontSize="48" FontWeight="Bold" Foreground="DarkGreen"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        
        <Button x:Name="button1" Grid.Row="2" Grid.ColumnSpan="3"
                Content="Csapat felvétel"
                FontSize="25" FontWeight="Bold" Foreground="White"
                Background="DarkBlue" BorderBrush="Black"
                Height="60" Width="250"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Click="button1_Click"/>

       
        <Button x:Name="button2" Grid.Row="3" Grid.ColumnSpan="3"
                Content="Kilépés"
                FontSize="25" FontWeight="Bold" Foreground="White"
                Background="DarkRed" BorderBrush="Black"
                Height="60" Width="250"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Click="button2_Click"/>
    </Grid>
</Window>
