<Window x:Class="kozgazkupa.csapatok"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Új Csapat Felvétele" Height="500" Width="800"
        Background="LightGray">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        
        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
               Content="Új Csapat Felvétele" FontSize="36" FontWeight="Bold"
               Foreground="DarkGreen" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        
        <Label Grid.Row="1" Grid.Column="1" Content="Csapatnév:" FontSize="20"
               HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBox x:Name="csapatnev" Grid.Row="1" Grid.Column="2" FontSize="20"
                 Width="250" Height="45" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        
        <Label Grid.Row="2" Grid.Column="1" Content="ID:" FontSize="20"
               HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBox x:Name="id" Grid.Row="2" Grid.Column="2" FontSize="20"
                 Width="250" Height="45" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        
        <Label Grid.Row="3" Grid.Column="1" Content="Fő:" FontSize="20"
               HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBox x:Name="fo" Grid.Row="3" Grid.Column="2" FontSize="20"
                 Width="250" Height="45" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        
        <Label Grid.Row="4" Grid.Column="1" Content="Székhely:" FontSize="20"
               HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBox x:Name="szekhely" Grid.Row="4" Grid.Column="2" FontSize="20"
                 Width="250" Height="45" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        
        <Label Grid.Row="5" Grid.Column="1" Content="Tulaj:" FontSize="20"
               HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBox x:Name="tulaj" Grid.Row="5" Grid.Column="2" FontSize="20"
                 Width="250" Height="45" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4"
                    Orientation="Horizontal" HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
            <Button x:Name="ok" Content="Ok" FontSize="18" Width="120" Height="50"
                    Background="DarkGreen" Foreground="White" Margin="10,0" Click="ok_Click"/>
            <Button x:Name="megse" Content="Mégse" FontSize="18" Width="120" Height="50"
                    Background="DarkOrange" Foreground="White" Click="megse_Click"/>
            <Button x:Name="Eredmenyek" Content="Eredmények" FontSize="18" Width="140" Height="50"
                    Background="DarkBlue" Foreground="White" Margin="10,0" Click="Eredmenyek_Click"/>
            <Button x:Name="kilepes" Content="Kilépés" FontSize="18" Width="120" Height="50"
                    Background="DarkRed" Foreground="White" Margin="10,0" Click="kilepes_Click_1"/>
        </StackPanel>
    </Grid>
</Window>
